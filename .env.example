# Окружение: development | test | production
APP_ENV=development

# Провайдер LLM по умолчанию (gigachat | ollama | openai)
DEFAULT_LLM_PROVIDER=gigachat

# GigaChat API (Сбер)
GIGACHAT_CREDENTIALS=your_gigachat_auth_key_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat

# Ollama (локальные модели)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# База данных
DATABASE_URL=sqlite:///./data/socratic_prod.db